+  static String _formatWalletTxnType(dynamic type) {
+    final str = type.toString();
+    if (str.contains('transferOut')) return '╪ز╪ص┘ê┘è┘ ╪╡╪د╪»╪▒';
+    if (str.contains('receiveIn')) return '╪ح┘è╪»╪د╪╣/┘ê╪د╪▒╪»';
+    if (str.contains('feeDeduction')) return '╪╣┘à┘ê┘╪ر ╪┤╪ذ┘â╪ر';
+    if (str.contains('adjustment')) return '╪ز╪│┘ê┘è╪ر';
+    return str;
+  }
