+        t('${row.remainingBalanceAfterRow.abs().toStringAsFixed(2)} ${row.remainingBalanceAfterRow >= 0 ? '┘┘╪د' : '╪╣┘┘è┘╪د'}'),
+        t(row.status.name),
       ]);
     }
 
